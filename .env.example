# Copy this file to .env and fill in the values before running docker compose up

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Kkr@13245
POSTGRES_DB=school_db

# ── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production

# ── AWS S3 (set to real values for S3 uploads) ──────────────────
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=uitb-school-ai-prod
AWS_ACCESS_KEY_ID=your_key_id
AWS_SECRET_ACCESS_KEY=your_secret_key

# ── Local upload fallback (set USE_LOCAL_UPLOAD=true for dev) ───
USE_LOCAL_UPLOAD=true
LOCAL_UPLOAD_BASE_URL=http://localhost:5000

# ── Admin token for model registration ──────────────────────────
# Get this by logging in as ADM_001 via POST /api/auth/login
BACKEND_TOKEN=
