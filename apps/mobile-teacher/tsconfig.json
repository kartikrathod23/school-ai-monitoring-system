{
  "extends": "expo/tsconfig.base",

  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./*"]
    },

    "types": ["nativewind/types"]
  },

  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    "env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}